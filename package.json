{
	"name": "hauscore",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.34.1",
	"scripts": {
		"dev": "pnpm --filter payload dev",
		"payload": "pnpm --filter payload dev",
		"payload:db": "docker compose -f apps/payload/docker-compose.yml up -d",
		"start": "pnpm --filter payload start",
		"storybook": "pnpm --filter @hauscore/ui storybook",
		"build": "pnpm --filter '*' build",
		"lint": "oxlint .",
		"format": "oxfmt .",
		"format:check": "oxfmt --check .",
		"typecheck": "pnpm exec tsc --noEmit -p libs/ui/components/tsconfig.json"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "4.2.1",
		"@tailwindcss/vite": "4.2.1",
		"oxfmt": "0.39.0",
		"oxlint": "1.53.0",
		"tailwindcss": "4.2.1",
		"typescript": "6.0.3"
	},
	"pnpm": {
		"onlyBuiltDependencies": ["esbuild", "sharp", "unrs-resolver"],
		"overrides": {
			"react": "19.2.6",
			"react-dom": "19.2.6"
		}
	},
	"dependencies": {
		"clsx": "2.1.1",
		"tailwind-merge": "3.5.0"
	}
}
